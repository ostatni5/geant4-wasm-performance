/process/em/verbose 0
/control/verbose 0
/run/verbose 1
/event/verbose 0
/tracking/verbose 0
/process/verbose 0

/run/printProgress -1

/score/create/boxMesh boxMesh
/score/mesh/boxSize 50. 50. 50. mm
/score/mesh/nBin 1 1 10
/score/quantity/energyDeposit eDep

/score/close

/run/initialize

/gps/particle proton
/gps/energy 60 MeV
/gps/direction 0. 0. 1.
/gps/position 0. 0. -2 cm
/gps/pos/type Beam
/gps/pos/radius 0.5 cm
/gps/pos/sigma_x 0.5 cm
/gps/pos/sigma_y 0.5 cm
/gps/ang/type beam2d

/run/beamOn 10000

/score/dumpQuantityToFile boxMesh eDep eDep.txt
